# Skopiuj do .env i uzupełnij wartości. Plik .env nigdy nie trafia do repo.

# Django
DJANGO_SETTINGS_MODULE=league_app.settings.dev
DJANGO_SECRET_KEY=zmien-mnie-na-cos-losowego-min-50-znakow
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Baza danych
# Dev: domyślnie SQLite (plik db.sqlite3), nie trzeba ustawiać DATABASE_URL.
# Prod: postgres://user:password@host:5432/dbname
# DATABASE_URL=postgres://score:score@localhost:5432/score_system

